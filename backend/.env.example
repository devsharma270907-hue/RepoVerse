# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/repoverse
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/repoverse

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption at rest (AES-256-GCM) ─────────────────────────────────────
# Encrypts third-party tokens stored in the DB (per-user GitHub PATs).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex

# ── Frontend URL ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── CORS (comma-separated for multiple origins) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Dev/test convenience (optional) ──────────────────────────────────────
# Set to true to run against an in-memory MongoDB (no local Mongo / Atlas needed)
# USE_MEMORY_DB=true

# ── GitHub ingestion (repo analyzer) ────────────────────────────────────
# Optional but recommended — unauthenticated GitHub API is capped at 60 req/hr
# Used for metadata pre-checks, clones, private repos and repository discovery.
# GITHUB_TOKEN=replace_with_pat
REPO_MAX_SIZE_MB=50
REPO_MAX_FILES=2000
REPO_MAX_FILE_SIZE_KB=200
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_TMP_DIR=./tmp/clones
# Max queued/running analyses per user (protects the worker queue)
ANALYSIS_MAX_QUEUED_PER_USER=2

# ── AI provider (optional — AI endpoints return 503 when unset) ─────────
ANTHROPIC_API_KEY=replace_with_key
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MONTHLY_TOKEN_BUDGET_PER_USER=200000
AI_EXPLAIN_MAX_SOURCE_CHARS=16000

# ── Embeddings / Atlas Vector Search (optional — Smart Search falls back
#    to keyword ranking when EMBEDDINGS_PROVIDER=none) ──────────────────
# Provider: none | voyage | openai (Anthropic has no embeddings API)
EMBEDDINGS_PROVIDER=none
# EMBEDDINGS_API_KEY=replace_with_provider_key
# Defaults: voyage-code-4 (voyage) / text-embedding-3-small (openai)
# EMBEDDINGS_MODEL=voyage-code-4
# Must match the Atlas index numDimensions below
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_BATCH_SIZE=64
EMBEDDINGS_MAX_FILES=500
# Create this index from backend/atlas/file_summaries_v1.json
VECTOR_INDEX_NAME=file_summaries_v1

# ── Google OAuth (optional — Google login disabled when unset) ───────────
# GOOGLE_CLIENT_ID=replace_with_client_id
# GOOGLE_CLIENT_SECRET=replace_with_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# Advanced: override endpoints for proxies / self-hosted OIDC
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=

# ── Rate limits ──────────────────────────────────────────────────────────
# Global + auth are per minute; analysis is per hour; AI is per minute,
# in addition to the monthly token budget.
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ANALYSIS_MAX=30
RATE_LIMIT_AI_MAX=30

# ── Monitoring (optional — unset SENTRY_DSN disables Sentry entirely) ───
# Errors-only by default; beforeSend scrubs headers, cookies, bodies and PII.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
