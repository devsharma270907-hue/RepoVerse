# RepoVerse frontend configuration.
# Copy to `.env` and adjust. Vite only exposes VITE_* variables to the client.

# Backend origin (no trailing slash, no /api/v1 suffix). Must be in the
# backend CORS_ORIGINS allowlist, e.g. http://localhost:5173 in development.
VITE_API_BASE_URL=http://localhost:5000

# Feature flags (optional, default true)
VITE_ENABLE_SMART_SEARCH=true
VITE_ENABLE_IMPACT_MODE=true
