# Dependencies (never commit — reinstall with npm ci)
node_modules/

# Environment & secrets — NEVER commit (only .env.example is allowed)
.env
.env.*
!.env.example
!.env.memory

# Private keys and common secret filenames
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# Build output
dist/
build/
out/
*.tsbuildinfo

# Logs & coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# RepoVerse analyzer temp workspace (cloned third-party repos)
tmp/

# OS / editor noise
.DS_Store
Thumbs.db
